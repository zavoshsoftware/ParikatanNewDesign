@model Models.Entities.Cost

@{
	ViewBag.Title = "افزودن " + Server.HtmlDecode(Html.DisplayNameFor(model => model).ToString());
	Layout = "~/Views/Shared/BackEndLayout/_BackEndLayout.cshtml";
}

@section styles
{
	<script src="~/Scripts/KendoPersianDate/JalaliDate.js"></script>
	<script src="~/Scripts/KendoPersianDate/kendo.web.js"></script>
	<script src="~/Scripts/KendoPersianDate/fa-IR.js"></script>
}
<h2>افزودن @Html.DisplayNameFor(model => model)</h2>

@using (Html.BeginForm("Create", "Costs", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
	@Html.AntiForgeryToken()

	<div class="form-horizontal">
		@Html.ValidationSummary(true)

		<div class="form-group">
			@Html.LabelFor(model => model.Amount, new { @class = "control-label col-md-2" })
			<div class="col-md-10">
				@Html.EditorFor(model => model.Amount)

				@Html.ValidationMessageFor(model => model.Amount)
			</div>
		</div>

		<div class="form-group">
			@Html.LabelFor(model => model.CostType, new { @class = "control-label col-md-2" })
			<div class="col-md-10">
				@Html.EnumDropDownListFor(model => model.CostType)

				@Html.ValidationMessageFor(model => model.CostType)
			</div>
		</div>

		<div class="form-group">
			@Html.LabelFor(model => model.Reciever, new { @class = "control-label col-md-2" })
			<div class="col-md-10">
				@Html.EditorFor(model => model.Reciever)

				@Html.ValidationMessageFor(model => model.Reciever)
			</div>
		</div>

		<div class="form-group">
			@Html.LabelFor(model => model.PayDate, new { @class = "control-label col-md-2" })
			<div class="col-md-10">
				@Html.EditorFor(model => model.PayDate)

				@Html.ValidationMessageFor(model => model.PayDate)
			</div>
		</div>

		<div class="form-group">
			<div class="col-md-2">
			</div>
			<div class="col-md-10">
				@Html.EditorFor(model => model.IsActive)

				@Html.LabelFor(model => model.IsActive)
				@Html.ValidationMessageFor(model => model.IsActive)
			</div>
		</div>

		<div class="form-group">
			@Html.LabelFor(model => model.Description, new { @class = "control-label col-md-2" })
			<div class="col-md-10">
				@Html.EditorFor(model => model.Description)

				@Html.ValidationMessageFor(model => model.Description)
			</div>
		</div>

		<div class="form-group" id="buttons">
			<div class="col-md-offset-2 col-md-10">
				<input type="submit" value="ایجاد" class="btn btn-primary" />
				@Html.ActionLink("بازگشت به فهرست", "Index")
			</div>
		</div>
	</div>
}

