@model IEnumerable<Models.Entities.Order>

@{
	ViewBag.Title = ViewBag.CurrentOrder;

	Layout = "~/Views/Shared/BackEndLayout/_BackEndLayout.cshtml";
}

<h2>@ViewBag.Title</h2>
@{
	string qs = Request["Grid-page"];
	int counter = 1;

	if (!string.IsNullOrEmpty(qs))
	{
		int pageid = Convert.ToInt32(qs);

		counter = ((pageid - 1) * 10) + 1;
	}
}
@(Html.Kendo().Grid(Model)
								.Name("Grid")
								.Columns(columns =>
								{

									columns.Template(@<text><span>@(counter++)</span></text>).Title("#");


                                    columns.Bound(model => model.OrderStatusStr);

                                    columns.Bound(model => model.User.FullName);
                                    columns.Bound(model => model.User.CellNum);
                                    columns.Bound(model => model.TotalAmountStr);
                                    columns.Bound(model => model.DiscountCode.Code);
                                    columns.Bound(model => model.IsPaid);
                                    columns.Bound(model => model.OrderTypeStr);
                                    //if (ViewBag.OrderType == "pos")
                                    //{
                                    //           columns.Bound(model => model.PaymentTypeTitle);
                                    //}
                                    //else
                                    //{
                                    //	columns.Bound(model => model.PaymentTypeTitleTranslate);

                                    //}

									@*columns.Bound(item => @item.Id).Title("نحوه پرداخت")
										.Template(@<text>

												          @if (item.IsPos)
												          {
													          @item.PaymentTypeTitle

												          }
												          else
												          {
													          <span>
														           @item.PaymentTypeTitleTranslate - @item.SaleReferenceId
													          </span>
												          }
											           </text>);*@

columns.Bound(model => model.OrderDateStr);
columns.Bound(item => @item.Id).Title("دستورات").Filterable(false).Groupable(false)
.Template(@<text>
									@Html.ActionLink("جزییات", "Details", new {id = @item.Id}, new {@class = "k-button"})

										@*@Html.ActionLink("پرداخت ها", "index","Payments", new {id = @item.Id}, new {@class = "k-button"})
										@Html.ActionLink("ویرایش", "edit","Pos", new {id = @item.Id}, new {@class = "k-button"})*@


							           </text>);
								})
		.ToolBar(toolbar =>
		{
			toolbar.Custom().Action("Create","Orders").Text("افزودن");
		}
		).Filterable().Sortable()
		.DataSource(dataSource => dataSource
									.Server()

									.Model(model => model.Id(item => item.Id))
					).Pageable(pager => pager.PageSizes(new object[] { 10, 20, 50, 100, "All" }))
	)
