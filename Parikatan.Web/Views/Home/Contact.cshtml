@using Helpers
@{
    ViewBag.Title = "تماس با ما | پریکاتن";
    ViewBag.Description = "راه‌های ارتباط با پریکاتن: تلفن، واتس‌اپ، ایمیل، نشانی و فرم ارسال پیام.";
    ViewBag.Canonical = "https://parikatan.shop/contact";
    ViewBag.NavActive = "contact";
    Layout = "~/Views/Shared/FrontEnd/_SiteLayout.cshtml";
}
@section head
{
    <link href="@SiteFormat.Asset("~/Assets/site/contact.css")" rel="stylesheet">
}
<div class="contact-p">

<div class="wrap">
  <nav class="crumbs" aria-label="مسیر صفحه">
    <a href="/">خانه</a><span>/</span><b>تماس با ما</b>
  </nav>
</div>

<!-- ============ HEADER ============ -->
<section class="ct-hero">
  <div class="wrap">
    <div class="k">تماس با ما</div>
    <h1>با ما در تماس باشید</h1>
    <p class="sub">برای خرید، مشاوره درباره‌ی محصولات یا هر پرسشی، از یکی از راه‌های زیر با پریکاتن در ارتباط باشید.</p>
  </div>
</section>

<!-- ============ SMS LINE (main way in) ============ -->
<section class="ct-sms-w">
  <div class="wrap">
    <div class="ct-sms">
      <div class="sms-text">
        <div class="k on-dark">سامانه‌ی پیامکی پریکاتن</div>
        <h2>عدد <span class="hl">۳</span> را به <span class="num" dir="ltr">۱۰۰۰۴۹۶۹</span> پیامک کنید</h2>
        <p>به پاس احترام و جلوگیری از اتلاف وقت شما، سامانه‌ی پیامکی پریکاتن را راه‌اندازی کرده‌ایم تا در صورت تمایل جهت خرید یا تکمیل اطلاعات درباره‌ی محصولات پریکاتن، با ارسال عدد ۳ به سامانه‌ی ۱۰۰۰۴۹۶۹، مشاورین ما در اولین فرصت با شما تماس حاصل کنند.</p>
        <div class="sms-act">
          <a class="btn white" href="sms:10004969?body=3"><svg class="i"><use href="#send"/></svg>ارسال پیامک</a>
          <button class="btn link" type="button" id="copy-sms">کپی شماره‌ی سامانه</button>
        </div>
      </div>
      <div class="sms-phone" aria-hidden="true">
        <div class="ph">
          <div class="ph-top"><span class="ph-av"><svg class="i"><use href="#send"/></svg></span><b dir="ltr">10004969</b></div>
          <div class="ph-body">
            <div class="bub me">۳</div>
            <div class="bub them">ممنون از پیام شما؛ مشاورین پریکاتن در اولین فرصت با شما تماس می‌گیرند.</div>
          </div>
          <div class="ph-input"><span>پیامک</span><i><svg class="i"><use href="#arrow"/></svg></i></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ CONTACT DETAILS + FORM ============ -->
<section class="s ct-main">
  <div class="wrap ct-grid">

    <div class="ct-info">
      <a class="ct-card" href="tel:02144063290">
        <span class="ic"><svg class="i"><use href="#phone"/></svg></span>
        <div><small>تلفن</small><b dir="ltr">۰۲۱-۴۴۰۶۳۲۹۰</b></div>
        <svg class="i go"><use href="#arrow"/></svg>
      </a>
      <a class="ct-card" href="https://wa.me/989014852865"><span class="ic"><svg class="i"><use href="#send"/></svg></span><div><small>واتس‌اپ</small><b dir="ltr">۰۹۰۱۴۸۵۲۸۶۵</b></div><svg class="i go"><use href="#arrow"/></svg></a>
      <a class="ct-card" href="mailto:info@parikatan.shop">
        <span class="ic"><svg class="i"><use href="#mail"/></svg></span>
        <div><small>ایمیل</small><b dir="ltr">info@parikatan.shop</b></div>
        <svg class="i go"><use href="#arrow"/></svg>
      </a>
      <div class="ct-card"><span class="ic"><svg class="i"><use href="#clock"/></svg></span><div><small>ساعت کاری</small><b>شنبه تا چهارشنبه: ۸ تا ۱۷ · پنجشنبه: ۸ تا ۱۳</b></div></div>
      <div class="ct-card addr">
        <span class="ic"><svg class="i"><use href="#pin"/></svg></span>
        <div><small>نشانی</small><b>تهران، بزرگراه اشرفی اصفهانی، بین بلوار مرزداران و پل حکیم، خیابان گلستان ۲۶، پلاک ۱، واحد ۶، طبقه‌ی سوم</b></div>
      </div>
      <div class="ct-map">
        <iframe title="نقشه‌ی پریکاتن" src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d2278.136537305028!2d51.34755572545765!3d35.736942467079935!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3f8e07335f7c0df1%3A0xe9a7b036ed2311e7!2z2KrYtNix24zZgdin2Kog2LTZh9in2Kg!5e0!3m2!1sen!2sus!4v1705312273098!5m2!1sen!2sus" style="border:0;width:100%;height:100%;min-height:220px" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        <a class="btn sm" href="https://www.google.com/maps/search/?api=1&amp;query=تهران،+بزرگراه+اشرفی+اصفهانی،+خیابان+گلستان+۲۶" target="_blank" rel="noopener">مسیریابی در نقشه <svg class="i"><use href="#arrow"/></svg></a>
      </div>
    </div>

    <div class="ct-form-card">
      <div id="ct-form-view">
        <h2>پیام بگذارید</h2>
        <p class="sub">پیام خود را بنویسید؛ همکاران ما در اولین فرصت پاسخ می‌دهند.</p>
        <form id="ct-form" novalidate>
          <div class="fgrid2">
            <div class="fld"><label for="c-name">نام و نام خانوادگی</label><input id="c-name" type="text" autocomplete="name" placeholder="مثلاً مریم احمدی"><div class="f-err"></div></div>
            <div class="fld"><label for="c-mobile">شماره موبایل</label><input id="c-mobile" type="tel" inputmode="numeric" autocomplete="tel-national" dir="ltr" placeholder="۰۹۱۲ ۳۴۵ ۶۷۸۹"><div class="f-err"></div></div>
            <div class="fld full"><label for="c-topic">موضوع</label>
              <div class="sel"><select id="c-topic"><option value="">انتخاب موضوع</option><option>مشاوره و خرید محصول</option><option>پیگیری سفارش</option><option>نمایندگی و همکاری</option><option>پیشنهاد یا انتقاد</option><option>سایر</option></select><svg class="i"><use href="#chev"/></svg></div><div class="f-err"></div></div>
            <div class="fld full"><label for="c-msg">پیام</label><textarea id="c-msg" rows="5" maxlength="250" placeholder="پیام خود را بنویسید…"></textarea><div class="f-err"></div></div>
          </div>
          <button class="btn ct-go" type="submit"><span>ارسال پیام</span><svg class="i"><use href="#arrow"/></svg></button>
        </form>
      </div>
      <div class="ct-done" id="ct-done" hidden>
        <div class="big"><svg class="i"><use href="#check"/></svg></div>
        <h2>پیام شما ثبت شد</h2>
        <p class="sub">ممنون از پیام شما؛ همکاران ما در اولین فرصت با شما تماس می‌گیرند.</p>
        <button class="btn sec" type="button" id="ct-again">ارسال پیام دیگر</button>
      </div>
    </div>

  </div>
</section>

</div>

@section scripts
{
    <script src="@SiteFormat.Asset("~/Assets/site/contact.js")"></script>
}