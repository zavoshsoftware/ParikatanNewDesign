@{
    Layout = null;
}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title</title>
    <meta name="description" content="@ViewBag.Description">
    <link rel="shortcut icon" type="image/x-icon" href="/assets/images/Faveicon.png">
    @if (!string.IsNullOrEmpty(ViewBag.Canonical as string))
    {
        <link rel="canonical" href="@ViewBag.Canonical" />
    }
    <meta name="robots" content="@(ViewBag.Robots ?? "index, follow")">
    <!-- Self-hosted Vazirmatn -->
    <link href="~/Assets/site/fonts/fonts.css" rel="stylesheet">
    <link href="@Helpers.SiteFormat.Asset("~/Assets/site/site.css")" rel="stylesheet">
    @RenderSection("head", required: false)
