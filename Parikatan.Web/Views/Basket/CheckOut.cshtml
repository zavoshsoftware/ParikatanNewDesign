@using Helpers
@model ViewModels.Basket.CheckOutViewModel
@{
    Layout = "~/Views/Shared/FrontEnd/_SiteLayout.cshtml";
    var fallbackImg = Url.Content("~/Assets/site/cream-closed.png");
    bool hasItems = Model.Products != null && Model.Products.Count > 0;
    var user = Model.UserInformation ?? new ViewModels.Basket.UserInformation();
}
@section head
{
    <link href="@SiteFormat.Asset("~/Assets/site/cart.css")" rel="stylesheet">
    <link href="@SiteFormat.Asset("~/Assets/site/checkout.css")" rel="stylesheet">
}

<div class="co">
    <div class="wrap">
        <nav class="crumbs" aria-label="مسیر صفحه">
            <a href="/">خانه</a><span>/</span><a href="/basket">سبد خرید</a><span>/</span><b>تکمیل سفارش</b>
        </nav>
    </div>

    <section class="co-wrap">
        <div class="wrap">

            <ol class="co-steps" aria-label="مراحل خرید">
                <li class="done"><a href="/basket"><span class="n"><svg class="i"><use href="#check" /></svg></span>سبد خرید</a></li>
                <li class="on" aria-current="step"><span class="n">۲</span>اطلاعات ارسال</li>
                <li><span class="n">۳</span>پرداخت</li>
            </ol>

            @if (hasItems)
            {
                <div class="co-grid" id="co-main">
                    <form class="co-form" id="co-form" novalidate>
                        <div class="co-card">
                            <div class="co-card-h"><span class="ic"><svg class="i"><use href="#badge" /></svg></span><div><h2>اطلاعات گیرنده</h2><p>سفارش به نام این شخص ارسال می‌شود.</p></div></div>
                            <div class="fgrid2">
                                <div class="fld full"><label for="f-name">نام و نام خانوادگی</label><input id="f-name" type="text" autocomplete="name" placeholder="مثلاً مریم احمدی" value="@user.FullName"><div class="f-err"></div></div>
                                <div class="fld"><label for="f-mobile">شماره موبایل <small>(شماره‌ی حساب شما؛ قابل ویرایش نیست)</small></label><input id="f-mobile" type="tel" inputmode="numeric" dir="ltr" readonly aria-readonly="true" tabindex="-1" placeholder="۰۹۱۲ ۳۴۵ ۶۷۸۹" value="@user.CellNumber"><div class="f-err"></div></div>
                            </div>
                        </div>

                        <div class="co-card">
                            <div class="co-card-h"><span class="ic"><svg class="i"><use href="#pin" /></svg></span><div><h2>آدرس ارسال</h2><p>آدرس را کامل و دقیق وارد کنید. سفارش از طریق تیپاکس ارسال می‌شود.</p></div></div>
                            <div class="fgrid2 three">
                                <div class="fld"><label for="f-postal">کد پستی</label><input id="f-postal" type="text" inputmode="numeric" autocomplete="postal-code" dir="ltr" placeholder="۱۲۳۴۵-۶۷۸۹۰"><div class="f-err"></div></div>
                                <div class="fld">
                                    <label for="f-province">استان</label>
                                    <div class="sel">
                                        <select id="f-province" autocomplete="address-level1">
                                            <option value="">انتخاب استان</option>
                                            @foreach (var province in Model.Provinces)
                                            {
                                                <option value="@province.Id">@province.Title</option>
                                            }
                                        </select><svg class="i"><use href="#chev" /></svg>
                                    </div>
                                    <div class="f-err"></div>
                                </div>
                                <div class="fld">
                                    <label for="f-city">شهر</label>
                                    <div class="sel"><select id="f-city" autocomplete="address-level2" disabled><option value="">ابتدا استان را انتخاب کنید</option></select><svg class="i"><use href="#chev" /></svg></div>
                                    <div class="f-err"></div>
                                </div>
                                <div class="fld full"><label for="f-address">آدرس</label><textarea id="f-address" rows="3" autocomplete="street-address" placeholder="خیابان، کوچه، پلاک، واحد"></textarea><div class="f-err"></div></div>
                            </div>
                        </div>
                    </form>

                    <aside class="co-sum" aria-label="خلاصه‌ی سفارش">
                        <div class="co-sum-h"><h2>خلاصه‌ی سفارش</h2><a href="/basket">ویرایش سبد</a></div>
                        <ul class="co-items">
                            @foreach (var it in Model.Products)
                            {
                                var p = it.Product;
                                decimal unit = SiteFormat.FinalAmount(p);
                                <li>
                                    <span class="th"><img src="@(string.IsNullOrEmpty(p.ImageUrl) ? fallbackImg : SiteFormat.Img(p.ImageUrl))" alt=""><i>@SiteFormat.Digits(it.Quantity)</i></span>
                                    <div><b>@p.Title</b><small>@SiteFormat.Digits(it.Quantity) × @SiteFormat.Price(unit)</small></div>
                                    <span class="lp">@SiteFormat.Price(unit * it.Quantity)</span>
                                </li>
                            }
                        </ul>
                        <div class="cs-row"><span>جمع کالاها (<b>@SiteFormat.Digits(Model.ItemCount)</b>)</span><b>@SiteFormat.Price(Model.SubTotalValue)</b></div>
                        @if (Model.DiscountValue > 0)
                        {
                            <div class="cs-row disc"><span>تخفیف</span><b>−@SiteFormat.Price(Model.DiscountValue)</b></div>
                        }
                        <div class="cs-row"><span>هزینه‌ی ارسال</span><b>@(Model.ShipmentValue > 0 ? SiteFormat.Price(Model.ShipmentValue) : "رایگان")</b></div>
                        <div class="cs-total"><span>مبلغ قابل پرداخت</span><b>@SiteFormat.Price(Model.TotalValue)</b></div>
                        <div class="co-err" id="co-err" role="alert" hidden></div>
                        <button class="btn co-go" type="submit" form="co-form" id="co-go"><span>ثبت اطلاعات و پرداخت</span><svg class="i"><use href="#arrow" /></svg></button>
                        <p class="co-wait" id="co-wait" hidden>لطفاً منتظر بمانید… در حال انتقال به درگاه پرداخت بانک</p>
                        <ul class="cart-trust">
                            <li><svg class="i"><use href="#lock" /></svg>اطلاعات شما فقط برای ارسال سفارش استفاده می‌شود</li>
                            <li><svg class="i"><use href="#shield" /></svg>خرید مستقیم از سایت رسمی پریکاتن</li>
                        </ul>
                    </aside>
                </div>
            }
            else
            {
                <div class="cart-empty" id="co-empty">
                    <div class="ce-vis" aria-hidden="true"><div class="ce-glow"></div><img src="~/Assets/site/cream-closed.png" alt="" width="500" height="500"></div>
                    <h2>سبد خرید شما خالی است</h2>
                    <p class="sub">برای تکمیل سفارش، ابتدا محصولی به سبد خرید اضافه کنید.</p>
                    <a class="btn" href="/product">مشاهده‌ی محصولات <svg class="i"><use href="#arrow" /></svg></a>
                </div>
            }

        </div>
    </section>
</div>

@section scripts
{
    @if (hasItems)
    {
        <script src="@SiteFormat.Asset("~/Assets/site/checkout.js")"></script>
    }
}
