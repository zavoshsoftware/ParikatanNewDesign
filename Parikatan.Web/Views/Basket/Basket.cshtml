@using Helpers
@model ViewModels.Basket.CartViewModel
@{
    Layout = "~/Views/Shared/FrontEnd/_SiteLayout.cshtml";
    var fallbackImg = Url.Content("~/Assets/site/cream-closed.png");
    bool hasItems = Model.Products != null && Model.Products.Count > 0;
    var suggestions = (Model.RelatedProducts ?? new List<Models.Entities.Product>()).Take(4).ToList();
}
@section head
{
    <link href="@Helpers.SiteFormat.Asset("~/Assets/site/cart.css")" rel="stylesheet">
}

<div class="wrap">
    <nav class="crumbs" aria-label="مسیر صفحه">
        <a href="/">خانه</a><span>/</span><b>سبد خرید</b>
    </nav>
</div>

<section class="cart-wrap">
    <div class="wrap">
        <div class="cart-head">
            <div><div class="k">سبد خرید</div><h1>سبد خرید شما</h1></div>
            <span class="cart-count" id="ccount">@(hasItems ? SiteFormat.Digits(Model.ItemCount) + " کالا" : "")</span>
        </div>

        <div class="cart-grid" id="cart-full" @(hasItems ? "" : "hidden")>
            <div>
                <div class="cart-items" id="citems">
                    @if (hasItems)
                    {
                        foreach (var it in Model.Products)
                        {
                            var p = it.Product;
                            decimal unit = SiteFormat.FinalAmount(p);
                            int max = p.Stock > 0 ? Math.Min(10, p.Stock) : 10;
                            <article class="ci" data-id="@p.Id" data-unit="@((long)unit)" data-max="@max">
                                <a class="ci-img" href="/product-detail/@p.Id"><img src="@(string.IsNullOrEmpty(p.ImageUrl) ? fallbackImg : SiteFormat.Img(p.ImageUrl))" alt="@p.Title"></a>
                                <div class="ci-info">
                                    @if (p.ProductCategory != null)
                                    {
                                        <span class="tag">@p.ProductCategory.Title</span>
                                    }
                                    <h3><a href="/product-detail/@p.Id">@p.Title</a></h3>
                                    <span class="unit">قیمت واحد: @SiteFormat.Price(unit)</span>
                                    @if (!SiteFormat.CanBuy(p))
                                    {
                                        <span class="unit" style="color:#A0493C">این محصول در حال حاضر ناموجود است؛ پیش از ادامه آن را حذف کنید.</span>
                                    }
                                </div>
                                <div class="ci-side">
                                    <div class="ci-total">@SiteFormat.Price(unit * it.Quantity)</div>
                                    <div class="ci-ctl">
                                        <div class="qty" aria-label="تعداد">
                                            <button type="button" data-d="-1" aria-label="کم کردن" @(it.Quantity <= 1 ? "disabled" : "")>−</button><span>@SiteFormat.Digits(it.Quantity)</span><button type="button" data-d="1" aria-label="زیاد کردن" @(it.Quantity >= max ? "disabled" : "")>+</button>
                                        </div>
                                        <button class="ci-del" type="button" aria-label="حذف از سبد"><svg class="i"><use href="#x" /></svg></button>
                                    </div>
                                </div>
                            </article>
                        }
                    }
                </div>
                <a class="btn link sm cart-more" href="/product"><svg class="i"><use href="#arrow" /></svg>ادامه‌ی خرید</a>
            </div>

            <aside class="cart-sum" aria-label="خلاصه‌ی سفارش">
                <h2>خلاصه‌ی سفارش</h2>
                <div class="cs-row"><span>جمع کالاها (<b id="sqty">@SiteFormat.Digits(Model.ItemCount)</b>)</span><b id="ssub">@SiteFormat.Price(Model.SubTotalValue)</b></div>
                <div class="cs-row disc" id="sdisc-row" @(Model.DiscountValue > 0 ? "" : "hidden")><span>تخفیف</span><b id="sdisc">−@SiteFormat.Price(Model.DiscountValue)</b></div>
                <div class="cs-row"><span>هزینه‌ی ارسال</span><b id="sship">@(Model.ShipmentValue > 0 ? SiteFormat.Price(Model.ShipmentValue) : "رایگان")</b></div>
                <div class="cs-total"><span>مبلغ قابل پرداخت</span><b id="stotal">@SiteFormat.Price(Model.TotalValue)</b></div>

                <form class="coupon" id="coupon" novalidate>
                    <label class="sr" for="ccode">کد تخفیف</label>
                    <input id="ccode" type="text" placeholder="کد تخفیف دارید؟" autocomplete="off">
                    <button type="submit">اعمال</button>
                </form>
                <div class="f-err" id="cmsg" role="status"></div>

                <a class="btn cart-go" id="checkout" href="@(User.Identity.IsAuthenticated ? "/checkout" : "/login?returnUrl=%2Fcheckout")">ادامه‌ی فرایند خرید <svg class="i"><use href="#arrow" /></svg></a>
                <ul class="cart-trust">
                    <li><svg class="i"><use href="#shield" /></svg>خرید مستقیم از سایت رسمی پریکاتن</li>
                    <li><svg class="i"><use href="#lock" /></svg>پرداخت امن</li>
                </ul>
            </aside>
        </div>

        <div class="cart-empty" id="cart-empty" @(hasItems ? "hidden" : "")>
            <div class="ce-vis" aria-hidden="true"><div class="ce-glow"></div><img src="~/Assets/site/cream-closed.png" alt="" width="500" height="500"></div>
            <h2>سبد خرید شما خالی است</h2>
            <p class="sub">محصولات پریکاتن را ببینید و هر کدام را که مناسب پوست شماست به سبد اضافه کنید.</p>
            <a class="btn" href="/product">مشاهده‌ی محصولات <svg class="i"><use href="#arrow" /></svg></a>
        </div>
    </div>
</section>

@if (suggestions.Count > 0)
{
    <section class="s cart-sugg" id="sugg">
        <div class="wrap">
            <div class="sh">
                <div><div class="k">پیشنهاد برای شما</div><h2>مراقبت را کامل کنید</h2></div>
                <a class="btn link sm" href="/product">مشاهده همه محصولات <svg class="i"><use href="#arrow" /></svg></a>
            </div>
            <div class="pgrid four" id="sgrid">
                @foreach (var r in suggestions)
                {
                    <article class="pc">
                        <div class="img"><a href="/product-detail/@r.Id"><img src="@(string.IsNullOrEmpty(r.ImageUrl) ? fallbackImg : SiteFormat.Img(r.ImageUrl))" alt="@r.Title" loading="lazy"></a></div>
                        <div class="body">
                            @if (r.ProductCategory != null) { <span class="tag">@r.ProductCategory.Title</span> }
                            <h3><a href="/product-detail/@r.Id">@r.Title</a></h3>
                            <div class="price">@SiteFormat.Price(SiteFormat.FinalAmount(r))</div>
                        </div>
                        <div class="row">
                            <a class="btn sm" href="/Basket" data-cart-add="@r.Id">افزودن به سبد</a>
                            <a class="btn sec sm" href="/product-detail/@r.Id">جزئیات</a>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
}

@section scripts
{
    <script src="@Helpers.SiteFormat.Asset("~/Assets/site/cart.js")"></script>
}
