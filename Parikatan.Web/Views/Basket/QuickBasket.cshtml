@model ViewModels.Basket.CartViewModel

@{
	ViewBag.Title = "سبد خرید";
	Layout = "~/Views/Shared/FrontEnd/_FronEndLayout.cshtml";
}
@*@section head{

	<link href="~/Assets_Old/css/style.css" rel="stylesheet" />
	<link href="~/Assets_Old/css/style-rtl.css" rel="stylesheet" />
}*@
<div class="container-fluid p-0 m-0">
	<section id="section10" dir="rtl">
		<img class="top-flower d-none d-lg-block" src="~/Assets/images/Asset 020.png" />
		<div class="container mt-5">
			<div class="row justify-content-end ">
				<div class="col-12">
					<h3 class="h1 mb-5">
						سبـــد خــــــرید   شـــــــما
						<img class="cart-icon" src="~/Assets/images/shopicon.png" />
					</h3>
				</div>
			</div>
			@if(Model.Products.Any()){
				<div class="row justify-content-center align-items-start">
					<div class="col-lg-8">
						<div class="row justify-content-center align-items-center m-3 m-lg-0">
							@foreach (var product in Model.Products)
							{

								<div class="col-12 product-card">
									<div class="row align-items-center ">
										<div class="col-lg-4 col-10 p-0  order-lg-0 order-0">
											<img class="product-img" src="@product.Product.ImageUrl" />
										</div>
										<div class="col-lg-7 order-lg-1 order-2">
											<div class="shop-box">
												<h3 class="mb-5 card-title">
													@product.Product.Title
												</h3>
												<div class="row d-flex mb-4" dir="rtl">

													<div class="col-6 text-end ">
														<div class="counter-box">
															<button type="button" class="btn btn-number" id="plus-product" onclick="Pluscounter1()">+</button>
															<span class="counter" id="counter-product1">@product.Quantity</span>
															<button type="button" class="btn btn-number" id="minus-product" onclick="minuscounter1()">-</button>
														</div>
													</div>
													<div class="col-6 text-end ">
														@product.Amount
													</div>
													</div>
													<div class="row d-flex" dir="rtl">

														<div class="col-12 p-0 d-flex text-end amount-box">
															<div class="col-5 text-center">
																<span class="amount-title">جمع</span>
															</div>
															<div class="col-7 text-start d-flex justify-content-end">
																<span class="amount-amount">@product.RowAmount</span>
															</div>
														</div>

													</div>

												</div>

										</div>
										<div class="col-lg-1 col-2 order-lg-2 order-1 ">
											<a  href="/Basket/remove/@product.Product.Id" class="btn close-btn">
												<img class=" icon" src="~/Assets/images/close-btn.png" />
											</a>
										</div>
									</div>

								</div>
								<hr/>
							}

						</div>
					</div>
					<div class="col-lg-4 ">
						<div class="row justify-content-start align-items-start m-3 m-lg-0">
							<div class="col-12  factor-details p-lg-3 p-3">
								<h4 class="mb-5 title">
									جزیـــیات فـــاکـــــتور
								</h4>
								<div class="row d-flex mb-4" dir="rtl">
									<div class="col-6">
										<span> قیمت کالاها:</span>

									</div>
									<div class="col-6 text-start">
										<span>@Model.SubTotal</span>
									</div>

								</div>
								<div class="row d-flex mb-4" dir="rtl">
									<div class="col-6">
										<span> تخفیف:</span>

									</div>
									<div class="col-6 text-start">
										<span>@Model.DiscountAmount</span>
									</div>


								</div>
								<div class="row d-flex mb-4" dir="rtl">
									<div class="col-6">
										<span> هزینه ارسال:</span>

									</div>
									<div class="col-6 text-start">
										<span>@Model.ShipmentAmount</span>
									</div>

								</div>
								<hr />
								<div class="row d-flex mb-5" dir="rtl">
									<div class="col-6">
										<strong>
											جمع کل:
										</strong>

									</div>
									<div class="col-6 text-start">
										<strong>
											@Model.Total
										</strong>
									</div>


								</div>
								<div class=" text-center mb-5">
									<div class="row">

										<div class="col-lg-12 mb-20">
											<label>نام و نام خانوادگی </label>
											<input class="input" type="text" id="fullname" style="float:left">
										</div>
										<div class="col-lg-12 mb-20">
											<label>شماره موبایل </label>
											<input class="input" type="text" id="cellnumber" value="" style="float:left">
										</div>
										</div>

									@*<a role="button" class="btn m-auto   navbar-btn-top complete-basket" href="/checkout">
										تکمیل سفارش و پرداخت
									</a>*@
									<button type="button" class="btn m-auto  navbar-btn-top finalize-order" onclick="finalizeOrderQuickBasket();">پرداخت</button>

								</div>
								@*<div class="col-lg-12">
								<div class="input-group mb-3">
									<button class="btn btn-outline-secondary" type="button" id="button-addon1">  کد تخفیف</button>
									<input type="text" class="form-control" placeholder="بررسی کد" aria-label="Example text with button addon" aria-describedby="button-addon1">
								</div>
							</div>*@
							</div>
						</div>
					</div>
				</div>
			}
			else
			{
				<p class="alert alert-danger">
					سبد خرید شما خالی است
					<br/>
					<a href="/product-detail/1" class="btn btn-info">کرم ضد چروک اصل پریکاتن</a>
					<a href="/product-detail/2" class="btn btn-info">کرم دور چشم اصل پریکاتن</a>
				</p>
			}
		</div>
	</section>
</div>
@*<div class="container-fluid p-0 m-0 d-md-none d-block">
    <div class="btn-fix-box">
        <div class=" text-center mb-3">
            <a role="button" class="btn m-auto   navbar-btn-top complete-basket" href="/checkout">تکمیل سفارش</a>
        </div>
    </div>
</div>*@

@section scripts
{
	<script src="~/Scripts/function.js"></script>

	<script src="~/Assets/scripts/counter.js"></script>
}
