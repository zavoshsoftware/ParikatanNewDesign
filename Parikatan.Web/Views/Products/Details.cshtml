</div>
<div class="container-fluid p-0 m-0 d-md-none d-block">
    <div class="btn-fix-box">
	    <div class=" text-center mb-3">
	    @if (Model.Product.Stock > 0)
	    {
		    <button onclick="addToBasket('@Model.Product.Id')" role="button" class="btn m-auto navbar-btn-top justify-content-center" id="add-to-basket-pdp-bottom">
			    <img class="shop-icon me-3" src="~/Assets/images/shopicon.png"/>افزودن به سبد خرید
		    </button>
		    }
	    else
	    {
		    <span class="alert alert-danger">
			    ناموجود
		    </span>
	    }
	    </div>
    </div>
</div>
@section scripts
{
	<link rel="stylesheet" href="/dist/slick/slick.css">
	<link rel="stylesheet" type="text/css" href="/dist/slick/slick-theme.css" />
	<script src="~/Assets/scripts/counter.js"></script>

    <script>
        function addToBasket(productCode) {
            var isValid = true;
        
            var qtyElement = $('#counter-product-' + productCode);
            var qty = parseInt(qtyElement.html());
            var stock = parseInt($('#hiddenStock').val());

      
            if (qty > stock) {
                alert('حداکثر تعداد سفارش از این محصول ' + stock + ' عدد است.');
                isValid = false;
            }

           
            if (isValid) {
                $.ajax({
                    url: "/Basket/AddToCart",
                    data: {
                        code: productCode,
                        qty: qty
                    },
                    type: "POST"
                }).done(function (result) {
                    if (result === "true") {
                        window.location.href = "/basket";
                    } else if (result === "invalid") {
                        alert('محصول انتخابی شما موجود نمی‌باشد.');
                    } else if (result === "false") {
                        alert('خطایی رخ داده است.');
                    }
                });
            }
        }
    </script>
}

