@using Helpers
@model ViewModels.Products.ProductDetailViewModel
@{
    Layout = "~/Views/Shared/FrontEnd/_SiteLayout.cshtml";
    var p = Model.Product;
    var fallbackImg = Url.Content("~/Assets/site/cream-closed.png");
    bool canBuy = SiteFormat.CanBuy(p);
    bool promo = p.IsInPromotion && p.DiscountAmount.HasValue;
    decimal finalAmount = SiteFormat.FinalAmount(p);
    int maxQty = Math.Max(1, Math.Min(10, p.Stock));
    string cat = p.ProductCategory != null ? p.ProductCategory.Title : null;

    // gallery: main image, second image, then the extra images; de-duplicated
    var gallery = new List<string>();
    Action<string> addImg = u => { if (!string.IsNullOrWhiteSpace(u) && !gallery.Contains(u)) { gallery.Add(u); } };
    addImg(p.ImageUrl);
    addImg(p.SecondImageUrl);
    foreach (var im in Model.ProductImages) { addImg(im.ImageUrl); }
    Func<string, bool> isPhoto = u => u.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || u.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase);

    var highlights = SiteFormat.Lines(p.Highlights);
    var specs = SiteFormat.Pairs(p.Specs);
    var benefits = SiteFormat.Pairs(p.Benefits);
    var techs = SiteFormat.Pairs(p.Technologies);
    var ingredients = SiteFormat.Lines(p.Ingredients);
    var steps = SiteFormat.Pairs(p.UsageSteps);
    var clinStats = SiteFormat.Pairs(p.ClinicalStats);
    bool hasClinical = !string.IsNullOrWhiteSpace(p.ClinicalText) || clinStats.Count > 0;
    bool hasStructured = benefits.Count > 0 || techs.Count > 0 || ingredients.Count > 0 || steps.Count > 0;
    string[] benefitIcons = { "sparkle", "leaf", "clock", "drop", "atom", "badge" };
    string[] techIcons = { "atom", "drop", "sparkle", "leaf", "clock", "flask" };

    // the free-text Body is only shown when the structured sections are not filled in
    bool hasBody = !string.IsNullOrWhiteSpace(p.Body) && !hasStructured;
    bool hasPackage = Model.PackageProducts.Count > 0;
    bool hasFaq = Model.Faqs.Count > 0;
    bool hasRelated = Model.RelatedProducts.Count > 0;

    var schemaGraph = new List<object>();
    schemaGraph.Add(new
    {
        @type = "Product",
        name = p.Title,
        description = SiteFormat.PlainText(p.Summery, 300),
        brand = new { @type = "Brand", name = "پریکاتن" },
        image = gallery.Select(SiteFormat.Img).ToList(),
        offers = new
        {
            @type = "Offer",
            priceCurrency = "IRR",
            price = ((long)finalAmount * 10).ToString(),
            availability = canBuy ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
            url = "https://parikatan.shop/product-detail/" + p.Id
        }
    });
    schemaGraph.Add(new
    {
        @type = "BreadcrumbList",
        itemListElement = new object[]
        {
            new { @type = "ListItem", position = 1, name = "خانه", item = "https://parikatan.shop/" },
            new { @type = "ListItem", position = 2, name = "محصولات", item = "https://parikatan.shop/product" },
            new { @type = "ListItem", position = 3, name = p.Title }
        }
    });
    if (hasFaq)
    {
        schemaGraph.Add(new
        {
            @type = "FAQPage",
            mainEntity = Model.Faqs.Select(f => new
            {
                @type = "Question",
                name = f.Question,
                acceptedAnswer = new { @type = "Answer", text = SiteFormat.PlainText(f.Response, 600) }
            }).ToList()
        });
    }
    var schema = new Dictionary<string, object> { { "@context", "https://schema.org" }, { "@graph", schemaGraph } };
}
@section head
{
    <link href="@Helpers.SiteFormat.Asset("~/Assets/site/detail.css")" rel="stylesheet">
    <script type="application/ld+json">@Html.Raw(Json.Encode(schema))</script>
}

<div class="wrap">
    <nav class="crumbs" aria-label="مسیر صفحه">
        <a href="/">خانه</a><span>/</span><a href="/product">محصولات</a><span>/</span><b>@p.Title</b>
    </nav>
</div>

<!-- ============ PRODUCT TOP ============ -->
<section class="pdp" id="top">
    <div class="wrap pdp-grid">

        <div class="gal">
            <div class="gmain" id="gmain">
                @{
                    string firstImg = gallery.Count > 0 ? SiteFormat.Img(gallery[0]) : fallbackImg;
                    bool firstPhoto = gallery.Count == 0 || isPhoto(gallery[0]);
                }
                <div class="float"><img id="gimg" class="@(firstPhoto ? "photo" : "")" src="@firstImg" alt="@p.Title" width="500" height="500"></div>
                @if (!string.IsNullOrWhiteSpace(p.Badge))
                {
                    <span class="gbadge"><svg class="i"><use href="#shield" /></svg>@p.Badge</span>
                }
            </div>
            @if (gallery.Count > 1)
            {
                <div class="gthumbs" role="tablist" aria-label="تصاویر محصول">
                    @for (int i = 0; i < gallery.Count && i < 8; i++)
                    {
                        var src = SiteFormat.Img(gallery[i]);
                        <button class="gt @(i == 0 ? "on" : "")" type="button" data-src="@src" data-alt="@p.Title" @(isPhoto(gallery[i]) ? "data-photo" : "") aria-label="تصویر @SiteFormat.Digits(i + 1)"><img class="@(isPhoto(gallery[i]) ? "photo" : "")" src="@src" alt=""></button>
                    }
                </div>
            }
        </div>

        <div class="buy">
            @if (cat != null)
            {
                <span class="tag">@cat</span>
            }
            <h1>@p.Title</h1>

            @if (!string.IsNullOrWhiteSpace(p.EnglishTitle))
            {
                <p class="en">@p.EnglishTitle</p>
            }

            @if (highlights.Count > 0)
            {
                <ul class="bul">
                    @foreach (var h in highlights)
                    {
                        <li><svg class="i"><use href="#check" /></svg>@h</li>
                    }
                </ul>
            }
            else if (!string.IsNullOrWhiteSpace(p.Summery))
            {
                <p class="summ">@p.Summery.Trim()</p>
            }

            @if (specs.Count > 0)
            {
                <div class="specs">
                    @foreach (var s in specs)
                    {
                        <div class="spec"><small>@s[0]</small><b>@s[1]</b></div>
                    }
                </div>
            }

            <div class="pricebox" id="pricebox">
                <div class="prow">
                    <div>
                        <div class="pl">قیمت</div>
                        <div class="pv">
                            @SiteFormat.Digits(Math.Round(finalAmount).ToString("n0", System.Globalization.CultureInfo.InvariantCulture).Replace(",", "٬")) <small>تومان</small>
                            @if (promo)
                            {
                                <s>@SiteFormat.Digits(Math.Round(p.Amount).ToString("n0", System.Globalization.CultureInfo.InvariantCulture).Replace(",", "٬"))</s>
                            }
                        </div>
                    </div>
                    @if (canBuy)
                    {
                        <span class="stock"><i></i>موجود در انبار</span>
                    }
                    else
                    {
                        <span class="stock" style="color:#8a4a3f;background:rgba(138,74,63,.08)"><i style="background:#8a4a3f;box-shadow:none"></i>ناموجود</span>
                    }
                </div>
                @if (canBuy)
                {
                    <div class="crow">
                        <div class="qty" aria-label="تعداد">
                            <button type="button" data-q="-1" aria-label="کم کردن">−</button><span id="qv" data-max="@maxQty">۱</span><button type="button" data-q="1" aria-label="زیاد کردن">+</button>
                        </div>
                        <a class="btn" href="/basket" id="addbtn" data-id="@p.Id" data-name="@p.Title">افزودن به سبد خرید</a>
                    </div>
                }
            </div>

            @if (hasClinical && !string.IsNullOrWhiteSpace(p.ClinicalNumber))
            {
                <div class="clin">
                    <div class="ic"><svg class="i"><use href="#shield" /></svg></div>
                    <div>
                        <b>دارای کارآزمایی بالینی و تأییدیه‌ی اثربخشی</b>
                        <span>شماره‌ی تأییدیه: <span class="no">@SiteFormat.Digits(p.ClinicalNumber)</span></span>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

<!-- ============ ANCHOR TABS ============ -->
<div class="tabs" id="tabs">
    <div class="wrap">
        @{ bool firstTab = true; Func<string> on = () => { var r = firstTab ? "on" : ""; firstTab = false; return r; }; }
        @if (benefits.Count > 0) { <a class="@on()" href="#benefits">مزایا</a> }
        @if (techs.Count > 0) { <a class="@on()" href="#tech">فناوری‌ها</a> }
        @if (ingredients.Count > 0) { <a class="@on()" href="#ingredients">ترکیبات</a> }
        @if (steps.Count > 0) { <a class="@on()" href="#usage">نحوه مصرف</a> }
        @if (hasBody) { <a class="@on()" href="#details">معرفی و جزئیات</a> }
        @if (hasPackage) { <a class="@on()" href="#package">اقلام پکیج</a> }
        @if (hasFaq) { <a class="@on()" href="#faq">سؤالات متداول</a> }
        <a class="@on()" href="#reviews">نظرات</a>
        @if (hasRelated) { <a href="#related">محصولات مرتبط</a> }
    </div>
</div>

@if (benefits.Count > 0)
{
    <section class="s" id="benefits">
        <div class="wrap">
            <div class="sh">
                <div><div class="k">مزایای محصول</div><h2>چرا @p.Title؟</h2></div>
            </div>
            <div class="bgrid">
                @for (int i = 0; i < benefits.Count; i++)
                {
                    <article class="bc"><div class="ic"><svg class="i"><use href="#@benefitIcons[i % benefitIcons.Length]" /></svg></div><div><h3>@benefits[i][0]</h3>@if (benefits[i][1].Length > 0) { <p>@benefits[i][1]</p> }</div></article>
                }
            </div>
        </div>
    </section>
}

@if (hasClinical)
{
    <section class="res-w">
        <div class="wrap">
            <div class="res">
                <div>
                    <div class="k">تأییدیه‌ی علمی</div>
                    <h2>کارآزمایی بالینی و تأییدیه‌ی اثربخشی</h2>
                    @if (!string.IsNullOrWhiteSpace(p.ClinicalText)) { <p>@p.ClinicalText</p> }
                    @if (!string.IsNullOrWhiteSpace(p.ClinicalNumber))
                    {
                        <div class="no"><svg class="i"><use href="#shield" /></svg>شماره‌ی تأییدیه: @SiteFormat.Digits(p.ClinicalNumber)</div>
                    }
                </div>
                @if (clinStats.Count > 0)
                {
                    <div class="stats">
                        @foreach (var st in clinStats)
                        {
                            <div class="stat"><b>@st[0]</b><span>@st[1]</span></div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (techs.Count > 0)
{
    <section class="s tech" id="tech">
        <div class="wrap">
            <div class="sh">
                <div><div class="k">فناوری و مواد اثرگذار</div><h2>آنچه در این محصول کار می‌کند</h2><p>عوامل اصلی فرمول را به زبان ساده بشناسید.</p></div>
            </div>
            <div class="tgrid">
                @for (int i = 0; i < techs.Count; i++)
                {
                    <div class="tc"><div class="top"><span class="n">@SiteFormat.Digits((i + 1).ToString("00"))</span><div class="ic"><svg class="i"><use href="#@techIcons[i % techIcons.Length]" /></svg></div></div><h3>@techs[i][0]</h3><p>@techs[i][1]</p></div>
                }
            </div>
        </div>
    </section>
}

@if (ingredients.Count > 0)
{
    <section class="s" id="ingredients">
        <div class="wrap ing">
            <div>
                <div class="k">ترکیبات</div>
                <h2>فهرست ترکیبات</h2>
                <p class="sub">ترکیبات این محصول در کنار این متن آمده است. مواد کلیدی با رنگ طلایی مشخص شده‌اند.</p>
                <div class="legend"><span><i style="background:var(--gold-soft);border:1px solid var(--gold)"></i>ماده‌ی کلیدی</span><span><i style="background:var(--subtle);border:1px solid var(--border)"></i>سایر ترکیبات</span></div>
            </div>
            <div class="ing-card">
                <div class="chips">
                    @foreach (var ing in ingredients)
                    {
                        bool key = ing.StartsWith("*");
                        <span class="ch@(key ? " key" : "")">@(key ? ing.Substring(1).Trim() : ing)</span>
                    }
                </div>
            </div>
        </div>
    </section>
}

@if (steps.Count > 0)
{
    <section class="s usage" id="usage">
        <div class="wrap">
            <div class="sh">
                <div><div class="k">نحوه‌ی مصرف</div><h2>@(SiteFormat.Digits(steps.Count)) قدم ساده</h2><p>برای بهترین نتیجه، مراحل زیر را دنبال کنید.</p></div>
            </div>
            <div class="usteps">
                @for (int i = 0; i < steps.Count; i++)
                {
                    <div class="us"><div class="n">@SiteFormat.Digits(i + 1)</div><h3>@steps[i][0]</h3><p>@steps[i][1]</p></div>
                }
            </div>
        </div>
    </section>
}

@if (hasBody)
{
    <section class="s" id="details">
        <div class="wrap">
            <div class="prose">@Html.Raw(p.Body)</div>
        </div>
    </section>
}

@if (hasPackage)
{
    <section class="s" id="package">
        <div class="wrap">
            <div class="sh"><div><div class="k">این پکیج شامل</div><h2>اقلام موجود در پکیج</h2></div></div>
            <div class="pk-pkg">
                @foreach (var c in Model.PackageProducts)
                {
                    <a href="/product-detail/@c.Id"><img src="@(string.IsNullOrEmpty(c.ImageUrl) ? fallbackImg : SiteFormat.Img(c.ImageUrl))" alt=""><b>@c.Title</b></a>
                }
            </div>
        </div>
    </section>
}

@if (hasFaq)
{
    <section class="s" id="faq">
        <div class="wrap faq">
            <div>
                <div class="k">سؤالات متداول</div>
                <h2>پاسخ به پرسش‌های شما</h2>
            </div>
            <div>
                @for (int i = 0; i < Model.Faqs.Count; i++)
                {
                    <details class="fq" @(i == 0 ? "open" : "")><summary>@Model.Faqs[i].Question<svg class="i"><use href="#plus" /></svg></summary><p>@Model.Faqs[i].Response</p></details>
                }
            </div>
        </div>
    </section>
}

<!-- ============ REVIEWS ============ -->
<section class="s reviews" id="reviews">
    <div class="wrap">
        <div class="sh">
            <div><div class="k">نظرات کاربران</div><h2>تجربه‌ی کاربران</h2><p>نظر خود را درباره‌ی این محصول با دیگران به اشتراک بگذارید.</p></div>
            <button class="btn sec sm" type="button" data-rm-open aria-haspopup="dialog">ثبت نظر</button>
        </div>
        <div class="rv solo">
            <div class="rcards">
                @if (Model.ProductComments.Count == 0)
                {
                    <p style="color:var(--text-2)">هنوز نظری برای این محصول ثبت نشده است. اولین نفر باشید.</p>
                }
                @foreach (var c in Model.ProductComments)
                {
                    var who = string.IsNullOrWhiteSpace(c.Name) ? "کاربر" : c.Name.Trim();
                    <article class="rc">
                        <div class="top">
                            <div class="who"><div class="av">@who.Substring(0, 1)</div><div><b>@who</b><span>@SiteFormat.Digits(c.CreationDateStr)</span></div></div>
                        </div>
                        <p>@c.Message</p>
                        @if (!string.IsNullOrWhiteSpace(c.Response))
                        {
                            <div class="reply"><b>پاسخ پریکاتن</b>@c.Response</div>
                        }
                    </article>
                }
            </div>
        </div>
    </div>
</section>

@if (hasRelated)
{
    <section class="s" id="related">
        <div class="wrap">
            <div class="sh">
                <div><div class="k">محصولات مرتبط</div><h2>مراقبت را کامل کنید</h2><p>سایر محصولات پریکاتن برای روتین مراقبت از پوست.</p></div>
                <a class="btn link sm" href="/product">مشاهده همه محصولات <svg class="i"><use href="#arrow" /></svg></a>
            </div>
            <div class="pgrid four">
                @foreach (var r in Model.RelatedProducts)
                {
                    <article class="pc">
                        <div class="img"><a href="/product-detail/@r.Id"><img src="@(string.IsNullOrEmpty(r.ImageUrl) ? fallbackImg : SiteFormat.Img(r.ImageUrl))" alt="@r.Title" loading="lazy"></a></div>
                        <div class="body">
                            @if (r.ProductCategory != null) { <span class="tag">@r.ProductCategory.Title</span> }
                            <h3><a href="/product-detail/@r.Id">@r.Title</a></h3>
                            <div class="price">@SiteFormat.Price(SiteFormat.FinalAmount(r))</div>
                        </div>
                        <div class="row">
                            @if (SiteFormat.CanBuy(r))
                            {
                                <a class="btn sm" href="/product-detail/@r.Id" data-add="@r.Id" data-name="@r.Title">افزودن به سبد</a>
                            }
                            <a class="btn sec sm" href="/product-detail/@r.Id">جزئیات</a>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
}

<!-- ============ REVIEW MODAL ============ -->
<div class="rmodal" id="rmodal" aria-hidden="true">
    <div class="rm-bg" data-rm-close></div>
    <div class="rm-dlg" role="dialog" aria-modal="true" aria-labelledby="rm-title" tabindex="-1">
        <div class="rm-view" id="rm-form-view">
            <div class="rm-head">
                <div><h3 id="rm-title">ثبت نظر شما</h3><p>تجربه‌ی خود را از این محصول با دیگران به اشتراک بگذارید.</p></div>
                <button class="rm-close" type="button" data-rm-close aria-label="بستن"><svg class="i"><use href="#x" /></svg></button>
            </div>
            <div class="rm-prod"><img src="@firstImg" alt=""><div><b>@p.Title</b></div></div>
            <form id="rm-form" novalidate data-url="/product-detail/@p.Id/comment">
                <div class="rm-field">
                    <label for="rm-name">نام</label>
                    <input id="rm-name" type="text" maxlength="100" autocomplete="name" placeholder="مثلاً مریم">
                    <div class="rm-err" id="err-name"></div>
                </div>
                <div class="rm-field">
                    <label for="rm-text">متن نظر</label>
                    <textarea id="rm-text" rows="4" maxlength="500" placeholder="از تجربه‌ی خود بنویسید؛ مثلاً بافت محصول، نحوه‌ی جذب و مدت استفاده"></textarea>
                    <div class="rm-count"><span class="rm-err" id="err-text"></span><span id="rm-cnt">۰ / ۵۰۰</span></div>
                </div>
                <div class="rm-actions">
                    <button class="btn" type="submit">ثبت نظر</button>
                    <button class="btn sec" type="button" data-rm-close>انصراف</button>
                </div>
            </form>
        </div>
        <div class="rm-view rm-ok" id="rm-done-view" hidden>
            <div class="big"><svg class="i"><use href="#check" /></svg></div>
            <h3>نظر شما ثبت شد</h3>
            <p>ممنون که تجربه‌ی خود را با ما در میان گذاشتید. نظر شما پس از بررسی در صفحه‌ی محصول نمایش داده می‌شود.</p>
            <button class="btn" type="button" data-rm-close>بستن</button>
        </div>
    </div>
</div>

@if (canBuy)
{
    <div class="sbar" id="sbar" aria-hidden="true">
        <div class="sp"><small>@p.Title</small><b>@SiteFormat.Price(finalAmount)</b></div>
        <a class="btn" href="/basket" data-id="@p.Id" data-name="@p.Title" id="addbtn2">افزودن به سبد خرید</a>
    </div>
}

@section scripts
{
    <script src="@Helpers.SiteFormat.Asset("~/Assets/site/detail.js")"></script>
}
