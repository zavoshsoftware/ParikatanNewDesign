@model ViewModels.Products.ProductDetailViewModel

@{
		Layout = "~/Views/Shared/FrontEnd/_FronEndLayout.cshtml";
		ViewBag.Canonical = "https://parikatan.shop/product-detail/" + Model.Product.Id;
	ViewBag.Description = Model.Product.PageDescription;
}
@section head{
	<style>
		.slider-nav {
			width: 100% !important;
		}
	</style>
}
<div class="container-fluid p-0 m-0">
	<section id="section08">
		<div class="container">
			<div class="row d-flex justify-content-center align-items-center shop-row position-relative">
				<div class="col-lg-5 col-10 text-center order-lg-2 order-0  position-relative" dir="ltr">
					<div class="row justify-content-center align-content-center slider-for ">
						@foreach (var image in Model.ProductImages)
						{
							<img class="slider-for-img" src="@image.ImageUrl" alt="@image.Title" />
						}
					</div>
					<div class="row justify-content-center align-content-center ">
						<div class="col-9 slider-nav">
							@foreach (var image in Model.ProductImages)
							{<img class="slider-for-img" src="@image.ImageUrl" alt="@image.Title" style="width: 100px !important; height: 100px" />}
						</div>
					</div>

				</div>
				<div class="col-lg-2 d-none d-lg-block text-center order-1">
					<img class="flower-top" src="~/Assets/images/Asset 03.png" />
					<img class="flower-down" src="~/Assets/images/Asset 02.png" />
				</div>

				<div class="col-lg-5 text-center order-lg-0 order-1 shop-box-contain">
					<div class="shop-box">
						<h1>@Model.Product.Title</h1>
						<div class="row d-flex" dir="rtl">
							<div class="col-6"><span> قیمت:</span></div>
							@if (Model.Product.IsInPromotion)
							{
								<div class="col-6">

									<span style="text-decoration: line-through;  display: block">@Model.Product.AmountStr</span>
									<span style="  display: block">@Model.Product.DiscountAmountStr</span>
								</div>
							}
							else
							{
								<div class="col-6">
									<span>@Model.Product.AmountStr</span>
								</div>
							}
						</div>
						@if (Model.Product.Stock > 0)
						{
							<div class="row d-flex" dir="rtl">
								<div class="col-6 "><span> تعداد:</span></div>
								<div class="col-6 ">
									<div class="counter-box">
										<button type="button" class="btn btn-number basket-plus" onclick="updateCounter(@Model.Product.Id, 1)">+</button>
										<span class="counter txt-qty-@Model.Product.Id" id="counter-product-@Model.Product.Id" data-product-id="@Model.Product.Id">1</span>
										<button type="button" class="btn btn-number basket-min" onclick="updateCounter(@Model.Product.Id, -1)">-</button>
									</div>
								</div>

							</div>
						}
						else
						{
							<span class="alert alert-danger">
								ناموجود
							</span>
						}
					</div>
					<div class="col-12 text-center">
						@if (Model.Product.Stock > 0)
						{
							<button onclick="addToBasket('@Model.Product.Id')" role="button" class="btn  navbar-btn-top" id="add-to-basket-pdp">
								<img class="shop-icon" src="~/Assets/images/shopicon.png" />افزودن به سبد خرید
							</button>
						}
					</div>
					<div class="row d-flex" dir="rtl">
						<div class="col-12">
							<p class="text-justify">@Model.Product.Summery</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section id="section09">
		<div class="container" dir="rtl">
			<div class="row">@Html.Raw(Model.Product.Body)</div>
		</div>
		<img class="img" src="~/Assets/images/Asset 05.png" />
	</section>
	<section style="direction: rtl; padding: 20px 0;text-align: center">
		<div class="container">

			<div class="shop_inner_area">
				<div class="row">
					<div class="col-12">
						<h2 style="margin-bottom: 30px">محصولات مرتبط پریکاتن</h2>
					</div>
				</div>

				<div class="row">
					<div class="col-12">
						<!--shop toolbar start-->

						<div class="row shop_wrapper">

							@foreach (var product in Model.RelatedProducts)
							{
								<div class="col-lg-4 col-md-4 col-12 ">
									<div class="single_product mb-2">
										<div class="product_thumb">
											<a class="primary_img" href="/product-detail/@product.Id">
												<img src="@System.Configuration.ConfigurationManager.AppSettings["baseUrl"]@product.ImageUrl" alt="@product.Title" style="max-width: 100%">
											</a>


										</div>

										<div class="product_content grid_content">
											<h3><a href="/product-detail/@product.Id">@product.Title</a></h3>
											@if (product.IsAvailable && product.Stock > 0)
											{
												if (product.IsInPromotion)
												{
													<span style="text-decoration: line-through;  display: block" class="old_price">@product.AmountStr</span>
													<span style=" display: block" class="current_price">@product.DiscountAmountStr</span>

												}
												else
												{

													<span class="current_price">@product.AmountStr</span>
												}
											

											}
											else
											{
												<span style="color:red">ناموجود</span>
												<button class="btn  navbar-btn-top" style="background-color:#adadad !important " disabled="disabled">
													<img class="shop-icon" src="~/Assets/images/shopicon.png" />ناموجود
												</button>
											}

										</div>


									</div>
								</div>
							}

						</div>
					</div>
				</div>




			</div>

		</div>
	</section>


