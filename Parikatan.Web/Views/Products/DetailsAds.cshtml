            </button>
        </div>
    </div>
</div>



<div id="modal-leater" class="modal">
    <div class="modal-content" dir="rtl">
        <span class="close">&times;</span>
        <div class="card-footer m-auto">
            <div class="footer-card-head">
                <h3 class="title">
                    عضویت در خبرنامـه
                </h3>
            </div>
            <div class="card-footer-body text-center">
	            <p class="text-center">
                جهت اطلاع از تخفیفات و محصولات جدید، شماره موبایل خـــود را وارد کــــنید
	            </p>
                <div class="input-group mb-3">

                    <input type="text" class="form-control d-block" id="mobileInput">
                    <p id="errorMsg" class="error-msg"></p>
                    <button class="btn btn-outline-secondary d-block" type="button" id="button-addon1">ثبت</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <link rel="stylesheet" href="/dist/slick/slick.css">
    <link rel="stylesheet" type="text/css" href="/dist/slick/slick-theme.css" />
    <script src="~/Assets/scripts/counter.js"></script>
    <script>


        var modal = document.getElementById('modal-leater');
        var mobileInput = document.getElementById('mobileInput');
        var submitBtn = document.getElementById('button-addon1');
        var errorMsg = document.getElementById('errorMsg');
        var span = document.getElementsByClassName("close")[0];
        window.onload = function () {
            modal.style.display = "block";
        }
        span.onclick = function () {
            modal.style.display = "none";
        }

        window.onclick = function (event) {
            if (event.target == modal) {
                modal.style.display = "none";
            }
        }

        function validateMobileNumber(mobileNumber) {
            var regex = /^(09)\d{9}$/;
            return regex.test(mobileNumber);
        }

        function handleSubmit() {
            var mobileNumber = mobileInput.value.trim();
            if (mobileNumber.length !== 11 || !validateMobileNumber(mobileNumber)) {

                errorMsg.textContent = "شماره موبایل به درستی وارد نشده,لطفا بررسی کنید.";
                errorMsg.style.display = "block";
                mobileInput.style.border = "1px solid red";
            } else {

                $.ajax({
                        url: "/Products/NewsLetterPhoneNumberPost",
                        data: {

                            phoneNumber: mobileNumber
                        },
                        cache: false,
                        type: "POST",
                        success: function (data) {
                            if (data.includes("true")) {

                }
                        },
                        error: function (reponse) {
                            alert("error : " + reponse);
                        }
                    });
            

                errorMsg.textContent = "ثبت با موفقیت انجام شد ";
                errorMsg.style.display = "block";
                errorMsg.style.color = "green";
                alert("ثبت با موفقیت انجام شد");
                  modal.style.display = "none";

            }
        }

        submitBtn.addEventListener('click', handleSubmit);

    </script>
    <script>
        function addToBasket(productCode) {
            var isValid = true;
            var qty = $('#counter-product').html();
            var stock = $('#hiddenStock').val();
            if (qty > stock) {
                alert('حداکثر تعداد سفارش از این محصول ' + stock + ' عدد است.');
                isValid = false;
            }

            if (isValid) {
                $.ajax(
                    {
                        url: "/Basket/AddToCart",
                        data: {
                            code: productCode,
                            qty: qty
                        },
                        type: "Post"
                    }).done(function (result) {
                        if (result === "true") {
                            window.location.href = "/basket";
                        } else if (result === "invalid") {
                            alert('محصول انتخابی شما موجود نمی باشد');
                        } else if (result === "false") {
                            alert('خطایی رخ داده است');
                        }
                    });
            }
        }
    </script>
}

