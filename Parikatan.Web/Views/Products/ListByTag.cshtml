@model ViewModels.Products.ProductListViewModel
@{
	ViewBag.Title = ViewBag.tagTitle;
	Layout = "~/Views/Shared/FrontEnd/_FronEndLayout.cshtml";
}

<div class="breadcrumbs_area">
	<div class="container">
		<div class="row">
			<div class="col-12">
				<div class="breadcrumb_content">
					<ul>
						<li><a href="/">خانه</a></li>
						<li>/</li>
						<li>@ViewBag.tagTitle</li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</div>
<!--breadcrumbs area end-->
<!--shop  area start-->
<div class="shop_area shop_fullwidth shop_reverse">
	<div class="container">
		<div class="shop_inner_area">
			<div class="row">
				<div class="col-12">
					<!--shop toolbar start-->
					<div class="shop_toolbar_wrapper">
					
				 
						<div class="page_amount">
							<p>تعداد کل محصولات این دسته بندی: @Model.TotalProductCount</p>
						</div>
						<div class="shop_toolbar_btn">
							<h1 style="font-size: 16px; color:#000">
								@ViewBag.tagTitle
							</h1>
						</div>
					</div>

					<div class="row shop_wrapper">

						@foreach (var product in Model.Products)
						{
							<div class="col-lg-4 col-md-4 col-12 ">
								<div class="single_product">
									<div class="product_thumb">
										<a class="primary_img" href="/product-detail/@product.Id"><img src="@System.Configuration.ConfigurationManager.AppSettings["baseUrl"]@product.ImageUrl" alt="@product.Title"></a>
										@if (product.SecondImageUrl != null)
										{
											<a class="secondary_img" href="/product-detail/@product.Id"><img src="@System.Configuration.ConfigurationManager.AppSettings["baseUrl"]@product.SecondImageUrl" alt="@product.Title"></a>
										}

										@if (!product.IsAvailable || product.Stock < 1)
										{
											<div class="product_sale">
												<span>ناموجود</span>
											</div>
										}
										else if (product.DiscountPercent != null && product.DiscountPercent != 0)
										{
											<div class="product_sale">
												<span>@product.DiscountPercent%</span>
											</div>
										}
									</div>

									<div class="product_content grid_content">
										<h3><a href="/product-detail/@product.Id">@product.Title</a></h3>
										@if (product.IsAvailable && product.Stock > 0)
										{
											if (product.IsInPromotion)
											{
												<span class="current_price">@product.DiscountAmountStr</span>
												<span class="old_price">@product.AmountStr</span>
											}
											else
											{
												<span class="current_price">@product.AmountStr</span>

											}
										}
									</div>


								</div>
							</div>
						}

					</div>
				</div>
			</div>

			<!--shop tab product end-->
			<div class="row">
				<div class="col-12">
					<!--shop toolbar start-->
					<div class="shop_toolbar t_bottom">
						<div class="pagination">
							<ul>
								@foreach (var pageItem in Model.PageItems)
								{
									if (pageItem.IsCurrentPage)
									{
										<li class="current">@pageItem.PageId</li>
									}
									else
									{
										<li><a href="/tag/@ViewBag.TagId?pageid=@pageItem.PageId">@pageItem.PageId</a></li>

									}
								}
								@*<li class="current">1</li>
									<li><a href="#">2</a></li>
									<li><a href="#">3</a></li>
									<li class="next"><a href="#">next</a></li>
									<li><a href="#">>></a></li>*@
							</ul>
						</div>
					</div>
					<!--shop toolbar end-->
				</div>
			</div>
		</div>

	</div>
</div>

