@using Helpers
@model ViewModels.Blogs.BlogDetailViewModel
@{
    Layout = "~/Views/Shared/FrontEnd/_SiteLayout.cshtml";
    var blog = Model.Blog;
    List<string[]> toc;
    string body = SiteFormat.AddHeadingIds(blog.Body, out toc);
    var related = Model.RelatedBlogs ?? new List<Models.Entities.Blog>();
    string url = "https://parikatan.shop/blog/post/" + blog.UrlParam;
    var schema = new Dictionary<string, object>
    {
        { "@context", "https://schema.org" },
        { "@type", "Article" },
        { "headline", blog.Title },
        { "description", SiteFormat.PlainText(blog.Summery, 300) },
        { "image", string.IsNullOrEmpty(blog.ImageUrl) ? new string[0] : new[] { SiteFormat.Img(blog.ImageUrl) } },
        { "datePublished", blog.CreationDate.ToString("yyyy-MM-dd") },
        { "mainEntityOfPage", url },
        { "publisher", new { @type = "Organization", name = "پریکاتن" } }
    };
}
@section head
{
    <link href="@SiteFormat.Asset("~/Assets/site/blog.css")" rel="stylesheet">
    <script type="application/ld+json">@Html.Raw(Json.Encode(schema))</script>
}

<div class="rprog" aria-hidden="true"><i id="rprog"></i></div>
<div class="art">

    <div class="wrap">
        <nav class="crumbs" aria-label="مسیر صفحه">
            <a href="/">خانه</a><span>/</span><a href="/blog">مجله پریکاتن</a><span>/</span><b>@blog.Title</b>
        </nav>
    </div>

    <header class="art-head">
        <div class="wrap">
            <div class="ah-text">
                @if (blog.BlogGroup != null) { <a class="tag" href="/blog/@blog.BlogGroup.UrlParam">@blog.BlogGroup.Title</a> }
                <h1>@blog.Title</h1>
                @if (!string.IsNullOrWhiteSpace(blog.Summery)) { <p class="lede">@blog.Summery.Trim()</p> }
                <div class="ah-meta">
                    <span class="by"><span class="av"><img src="~/Assets/site/logo.png" alt=""></span><span><b>تیم محتوای پریکاتن</b><small>@SiteFormat.Digits(blog.CustomeCreationDate) · @SiteFormat.Digits(SiteFormat.ReadMinutes(blog.Body)) دقیقه مطالعه</small></span></span>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(blog.ImageUrl))
            {
                <div class="ah-vis"><img src="@blog.ImageUrl" alt="@blog.Title"></div>
            }
        </div>
    </header>

    <div class="wrap art-grid">

        <aside class="art-side">
            @if (toc.Count > 1)
            {
                <nav class="toc" aria-label="فهرست مطالب">
                    <b>در این مقاله</b>
                    @foreach (var t in toc)
                    {
                        <a href="#@t[0]">@t[1]</a>
                    }
                </nav>
            }
            <div class="share">
                <b>اشتراک‌گذاری</b>
                <div>
                    <button type="button" class="sh-btn" id="copylink" aria-label="کپی لینک مقاله"><svg class="i"><use href="#send" /></svg></button>
                    <a class="sh-btn" href="https://wa.me/?text=@Server.UrlEncode(blog.Title + " " + url)" target="_blank" rel="noopener" aria-label="اشتراک در واتس‌اپ"><svg class="i"><use href="#phone" /></svg></a>
                </div>
            </div>
        </aside>

        <article class="prose">
            @Html.Raw(body)

            <div class="art-foot">
                <p class="note">این مقاله برای آگاهی عمومی نوشته شده و جایگزین مشاوره‌ی پزشک نیست.</p>
            </div>

            <section class="art-cm" id="comments" style="max-width:none">
                <h2>نظرات@(Model.BlogComments != null && Model.BlogComments.Count > 0 ? " (" + SiteFormat.Digits(Model.BlogComments.Count) + ")" : "")</h2>
                @foreach (var c in Model.BlogComments ?? new List<Models.Entities.BlogComment>())
                {
                    <div class="cm">
                        <b>@(string.IsNullOrWhiteSpace(c.Name) ? "کاربر" : c.Name)</b><small>@SiteFormat.Digits(c.CreationDateStr)</small>
                        <p>@c.Message</p>
                        @if (!string.IsNullOrWhiteSpace(c.Response)) { <div class="reply"><b style="font-size:12.5px;color:var(--gold-dark)">پاسخ پریکاتن</b>@c.Response</div> }
                    </div>
                }
                <form class="cm-form" id="cm-form" novalidate data-code="@blog.UrlParam">
                    <div class="two">
                        <input id="cm-name" type="text" maxlength="100" placeholder="نام" aria-label="نام">
                        <input id="cm-email" type="email" dir="ltr" placeholder="ایمیل (نمایش داده نمی‌شود)" aria-label="ایمیل">
                    </div>
                    <textarea id="cm-body" maxlength="1000" placeholder="نظر شما" aria-label="نظر شما"></textarea>
                    <div class="cm-msg" id="cm-msg" role="status"></div>
                    <div><button class="btn" type="submit">ثبت نظر</button></div>
                </form>
            </section>
        </article>
    </div>

    @if (related.Count > 0)
    {
        <section class="s art-rel">
            <div class="wrap">
                <div class="sh">
                    <div><div class="k">مقاله‌های مرتبط</div><h2>بیشتر بخوانید</h2></div>
                </div>
                <div class="agrid bl-grid">
                    @foreach (var b in related)
                    {
                        <article class="ac">
                            <a class="img @(string.IsNullOrEmpty(b.ImageUrl) ? "noimg" : "")" href="/blog/post/@b.UrlParam" aria-hidden="true" tabindex="-1">
                                @if (!string.IsNullOrEmpty(b.ImageUrl)) { <img src="@b.ImageUrl" alt="@b.Title" loading="lazy"> }
                            </a>
                            <div class="body">
                                @if (b.BlogGroup != null) { <span class="tag">@b.BlogGroup.Title</span> }
                                <h3><a href="/blog/post/@b.UrlParam">@b.Title</a></h3>
                                <p>@SiteFormat.PlainText(b.Summery, 120)</p>
                                <div class="meta"><svg class="i"><use href="#clock" /></svg>@SiteFormat.Digits(SiteFormat.ReadMinutes(b.Body)) دقیقه مطالعه</div>
                            </div>
                        </article>
                    }
                </div>
            </div>
        </section>
    }
</div>

@section scripts
{
    <script src="@SiteFormat.Asset("~/Assets/site/blog.js")"></script>
}
