@using Helpers
@model ViewModels.ActivateAccountViewModel
@{
    ViewBag.Title = "تأیید شماره موبایل | پریکاتن";
    ViewBag.Robots = "noindex, follow";
    Layout = "~/Views/Shared/FrontEnd/_SiteLayout.cshtml";
    string error = TempData["WrongActivationCode"] as string;
    string cell = Model.CellNumber ?? "";
    string prettyCell = cell.Length == 11 ? cell.Substring(0, 4) + " " + cell.Substring(4, 3) + " " + cell.Substring(7) : cell;
    string returnUrl = ViewBag.ReturnUrl as string;
}
@section head
{
    <link href="@SiteFormat.Asset("~/Assets/site/auth.css")" rel="stylesheet">
}

<div class="auth">
    <div class="wrap auth-grid">

        <section class="auth-card" aria-labelledby="auth-title">
            <div id="otp-view">
                <div class="k">تأیید شماره موبایل</div>
                <h1 id="auth-title">کد تأیید را وارد کنید</h1>
                <p class="sub">کد تأیید به شماره‌ی <b class="vphone" dir="ltr">@SiteFormat.Digits(prettyCell)</b> پیامک شد.</p>
                <a class="edit-phone" href="/login@(string.IsNullOrEmpty(returnUrl) ? "" : "?returnUrl=" + Server.UrlEncode(returnUrl))"><svg class="i"><use href="#arrow" /></svg>ویرایش شماره</a>

                @using (Html.BeginForm("Activate", "Accounts", new { returnUrl = returnUrl, code = ViewBag.code }, FormMethod.Post, new { id = "otp-form", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.CellNumber)
                    <input type="hidden" name="ActivationCode" id="ActivationCode" value="">

                    <div class="otp @(error != null ? "bad" : "")" id="otp" dir="ltr" role="group" aria-label="کد تأیید">
                        <input type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="5" aria-label="رقم ۱">
                        <input type="text" inputmode="numeric" maxlength="1" aria-label="رقم ۲">
                        <input type="text" inputmode="numeric" maxlength="1" aria-label="رقم ۳">
                        <input type="text" inputmode="numeric" maxlength="1" aria-label="رقم ۴">
                        <input type="text" inputmode="numeric" maxlength="1" aria-label="رقم ۵">
                    </div>
                    <div class="f-err" id="otp-err" role="alert">@error</div>
                    <div class="otp-meta">
                        <span id="otp-timer">ارسال مجدد کد تا <b id="otp-left">۰۲:۰۰</b></span>
                        <button class="resend" id="otp-resend" type="button" hidden>ارسال مجدد کد</button>
                    </div>
                    <button class="btn auth-btn" type="submit" disabled><span>تأیید و ورود</span><svg class="i"><use href="#arrow" /></svg></button>
                }

                @* resend = post the number again to the login action, which sends a new code and returns here *@
                @using (Html.BeginForm("OtpLogin", "Accounts", FormMethod.Post, new { id = "resend-form" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ReturnUrl" value="@returnUrl">
                    <input type="hidden" name="UserCellNumber" value="@cell">
                }
            </div>
        </section>

        <aside class="auth-vis" aria-hidden="true">
            <div class="av-glow"></div>
            <div class="av-jar">
                <img class="j-open" src="~/Assets/site/cream-open.png" alt="" width="500" height="500">
                <img class="j-closed" src="~/Assets/site/cream-closed.png" alt="" width="500" height="500">
            </div>
            <div class="av-chip c1"><span><svg class="i"><use href="#shield" /></svg></span><b>کارآزمایی بالینی</b></div>
            <div class="av-chip c2"><span><svg class="i"><use href="#flask" /></svg></span><b>فرموله‌شده در SEPPIC فرانسه</b></div>
            <p class="av-cap">مراقبت علمی و جوان‌سازی پوست</p>
        </aside>

    </div>
</div>

@section scripts
{
    <script src="@SiteFormat.Asset("~/Assets/site/auth.js")"></script>
}
