@model ViewModels.ForgetPasswordViewModel
@{
    ViewBag.Title = "ورود / ثبت‌نام | پریکاتن";
    ViewBag.Robots = "noindex, follow";
    Layout = "~/Views/Shared/FrontEnd/_SiteLayout.cshtml";
    string error = TempData["WrongMobile"] as string;
}
@section head
{
    <link href="@Helpers.SiteFormat.Asset("~/Assets/site/auth.css")" rel="stylesheet">
}

<div class="auth">
    <div class="wrap auth-grid">

        <section class="auth-card" aria-labelledby="auth-title">
            <div class="k">ورود / ثبت‌نام</div>
            <h1 id="auth-title">به پریکاتن خوش آمدید</h1>
            <p class="sub">برای ورود یا ساخت حساب کاربری و تکمیل سفارش، شماره موبایل خود را وارد کنید. کد تأیید برایتان پیامک می‌شود.</p>

            @using (Html.BeginForm("OtpLogin", "Accounts", FormMethod.Post, new { id = "login-form", novalidate = "novalidate" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl">
                <input type="hidden" name="UserCellNumber" id="UserCellNumber" value="">

                <label class="f-label" for="mobile">شماره موبایل</label>
                <div class="phone-field @(error != null ? "bad" : "")">
                    <input id="mobile" type="tel" inputmode="numeric" autocomplete="tel-national" dir="ltr" placeholder="۰۹۱۲ ۳۴۵ ۶۷۸۹" maxlength="16" aria-describedby="phone-err">
                    <span class="pf-ic" aria-hidden="true"><svg class="i"><use href="#phone" /></svg></span>
                </div>
                <div class="f-err" id="phone-err" role="alert">@error</div>
                <button class="btn auth-btn" type="submit"><span>دریافت کد تأیید</span><svg class="i"><use href="#arrow" /></svg></button>
            }

            <p class="terms">ورود شما به معنای پذیرش قوانین و مقررات و حریم خصوصی پریکاتن است.</p>

            <ul class="auth-perks">
                <li><svg class="i"><use href="#check" /></svg>پیگیری سفارش‌ها</li>
                <li><svg class="i"><use href="#check" /></svg>ذخیره‌ی سبد خرید</li>
                <li><svg class="i"><use href="#check" /></svg>ثبت نظر برای محصولات</li>
            </ul>
        </section>

        <aside class="auth-vis" aria-hidden="true">
            <div class="av-glow"></div>
            <div class="av-jar"><img class="j-closed" src="~/Assets/site/cream-closed.png" alt="" width="500" height="500"></div>
            <div class="av-chip c1"><span><svg class="i"><use href="#shield" /></svg></span><b>کارآزمایی بالینی</b></div>
            <div class="av-chip c2"><span><svg class="i"><use href="#flask" /></svg></span><b>فرموله‌شده در SEPPIC فرانسه</b></div>
            <p class="av-cap">مراقبت علمی و جوان‌سازی پوست</p>
        </aside>

    </div>
</div>

@section scripts
{
    <script src="@Helpers.SiteFormat.Asset("~/Assets/site/auth.js")"></script>
}
